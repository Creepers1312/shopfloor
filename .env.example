# Shopfloor Board — Beispielkonfiguration
# Am einfachsten mit ./deploy.sh erzeugen lassen; manuell: nach .env kopieren und anpassen.

# Projektname (Präfix für Container, Netze, Volumes)
COMPOSE_PROJECT_NAME='shopfloor'

# Betriebsart: port = eigener Port · proxy = im Docker-Netz eines vorhandenen Reverse Proxys
DEPLOY_MODE='port'

# Docker-Netz des Reverse Proxys (nur bei DEPLOY_MODE=proxy), z. B. npm_default
PROXY_NETWORK=''

# Compose-Dateien — ergibt sich aus der Betriebsart (proxy: docker-compose.yml:deploy/compose.proxy.yml)
COMPOSE_FILE='docker-compose.yml'

# IP-Adresse, an die der Web-Port gebunden wird (127.0.0.1 = nur lokal)
WEB_BIND='0.0.0.0'

# Port für das Board auf diesem Server
WEB_PORT='8080'

# Adresse, unter der das Board erreichbar ist (nur Info / Standard für COOKIE_SECURE)
PUBLIC_URL='https://shopfloor.example.de'

# Zeitzone (für Sicherungszeiten und Dateinamen)
TZ='Europe/Berlin'

# Datenbank
DB_NAME='shopfloor'
DB_USER='shopfloor'
DB_PASSWORD='bitte-ein-langes-zufaelliges-passwort'

# Schlüssel für gespeicherte Zugangsdaten (SMB-Passwort) — wird von deploy.sh erzeugt
APP_SECRET='bitte-ein-langes-zufaelliges-geheimnis'

# Dürfen sich neue Benutzer selbst registrieren? (das allererste Konto geht immer)
ALLOW_REGISTER='false'

# Demo-Zugang (nur Lesen) auf der Anmeldeseite anbieten?
ALLOW_DEMO='false'

# Wie viele Tage bleibt eine Anmeldung höchstens gültig?
SESSION_DAYS='14'

# Nach wie vielen Stunden ohne Aktivität abmelden? (0 = nie)
SESSION_IDLE_HOURS='12'

# Mindestlänge für Passwörter
PASSWORD_MIN_LENGTH='10'

# Sitzungs-Cookie nur über HTTPS senden? (true, sobald ein Reverse Proxy mit TLS davor steht)
COOKIE_SECURE='true'

# IP-Adresse(n) des Reverse Proxys (z. B. Nginx Proxy Manager), mit Komma getrennt.
# Nur von dort wird X-Forwarded-For als echte Client-IP übernommen — wichtig für die
# Login-Bremse und das Sicherheitsprotokoll. Leer = kein Proxy davor.
TRUSTED_PROXIES=''

# E-Mail für „Passwort vergessen“ (SMTP). Leer = kein Versand — Anfragen gehen dann an die
# Administration (Einstellungen → Benutzerverwaltung). Test: ./deploy.sh mail-test adresse@firma.de
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURITY='starttls'
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM='Shopfloor Board <shopfloor@firma.de>'

# Sicherungen: Ordner auf dem Host, Standard für Zeitplan und Aufbewahrung
# (Zeitplan und Aufbewahrung lassen sich danach in der Oberfläche ändern)
BACKUP_PATH='./backups'
BACKUP_ENABLED='true'
BACKUP_TIME='02:00'
BACKUP_KEEP='14'

